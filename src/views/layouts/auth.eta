<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> — <%= it.brand.name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<link rel="icon" href="/img/mark.svg" type="image/svg+xml">
</head>
<body>
<div style="min-height:100vh;display:grid;place-items:center;padding:34px 18px;position:relative;overflow:hidden">
  <div style="position:absolute;width:760px;height:760px;top:-330px;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(47,107,255,.15),transparent 62%);pointer-events:none"></div>
  <div style="width:100%;max-width:440px;position:relative">
    <a class="logo" href="/" style="justify-content:center;margin-bottom:24px">
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="9" fill="#0A1020"/>
        <path d="M4 22a12 12 0 0124-6" fill="none" stroke="url(#a-arc)" stroke-width="2.4" stroke-linecap="round"/>
        <path d="M7 22L13 12l4 6 3-5 5 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="25" cy="9" r="2.4" fill="#16C784"/>
        <defs><linearGradient id="a-arc" x1="0" y1="32" x2="32" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#16C784"/><stop offset="1" stop-color="#4D82FF"/></linearGradient></defs>
      </svg>
      <span>Rydon<em>Invest</em></span>
    </a>
    <%~ it.body %>
  </div>
</div>
</body>
</html>
