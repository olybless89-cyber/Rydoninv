<div class="page-head"><h1>Live markets</h1>
  <p class="small" style="margin:4px 0 0">Real-time prices from our aggregated feed, refreshed every few seconds.</p>
</div>

<div class="card" style="padding:0;overflow:hidden;margin-bottom:22px">
  <div class="card-head"><h3>Watchlist</h3><span class="badge badge-live">Streaming</span></div>
  <div class="mw-grid">
    <% (it.prices || []).forEach(function(p){ %>
      <a class="mw-coin" href="/markets/crypto/<%= p.symbol.toLowerCase() %>">
        <%~ it.coinLogo(p.symbol, 28) %>
        <div class="mw-coin-info">
          <div class="mw-sym"><%= p.symbol %><span class="mw-pair">/USD</span></div>
          <div class="num mw-price"><%= p.price ? it.usd(p.price, p.price < 5 ? 4 : 2) : '—' %></div>
        </div>
        <span class="mw-chg num <%= it.dir(p.change) %>"><%= it.pct(p.change) %></span>
      </a>
    <% }) %>
  </div>
</div>

<div class="grid" style="grid-template-columns:1.4fr .6fr;gap:20px">
  <div class="card" style="padding:0;overflow:hidden;height:600px">
    <div class="tradingview-widget-container" style="height:100%">
      <div class="tradingview-widget-container__widget" style="height:100%"></div>
      <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js" async>
      {"autosize":true,"symbol":"BITSTAMP:BTCUSD","interval":"60","timezone":"Etc/UTC","theme":"dark","style":"1","locale":"en","backgroundColor":"#0D1626","gridColor":"rgba(30,47,77,0.5)","withdateranges":true,"allow_symbol_change":true,"details":true,"studies":["STD;RSI"],"support_host":"https://www.tradingview.com"}
      </script>
    </div>
  </div>
  <div class="card" style="padding:0;overflow:hidden;height:600px">
    <div class="tradingview-widget-container" style="height:100%">
      <div class="tradingview-widget-container__widget" style="height:100%"></div>
      <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-screener.js" async>
      {"width":"100%","height":"100%","defaultColumn":"overview","screener_type":"crypto_mkt","displayCurrency":"USD","colorTheme":"dark","isTransparent":true,"locale":"en"}
      </script>
    </div>
  </div>
</div>
